{
  "name": "@xquik/tweetclaw",
  "version": "1.7.1",
  "description": "Twitter bot plugin for OpenClaw. Post, reply, search tweets, export followers & monitor accounts through Xquik. Not affiliated with X Corp.",
  "license": "MIT",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xquik-dev/tweetclaw.git"
  },
  "homepage": "https://github.com/Xquik-dev/tweetclaw#readme",
  "bugs": {
    "url": "https://github.com/Xquik-dev/tweetclaw/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    },
    "install": {
      "defaultChoice": "clawhub",
      "clawhubSpec": "clawhub:@xquik/tweetclaw",
      "npmSpec": "@xquik/tweetclaw@1.7.1",
      "minHostVersion": ">=2026.7.1"
    }
  },
  "files": [
    "CHANGELOG.md",
    "generated-api-contract.json",
    "dist/",
    "src/",
    "skills/tweetclaw/",
    "openclaw.plugin.json"
  ],
  "keywords": [
    "openclaw-plugin",
    "twitter",
    "x",
    "automation",
    "tweetclaw",
    "xquik",
    "twitter-api",
    "x-api",
    "social-media",
    "scraper",
    "ai-agent",
    "data-extraction",
    "giveaway",
    "monitoring",
    "tweet",
    "twitter-scraper",
    "twitter-bot",
    "x-twitter",
    "tweet-api",
    "twitter-automation",
    "openclaw",
    "twitter automation",
    "openclaw twitter",
    "openclaw twitter plugin",
    "openclaw x plugin"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip --strict --treat-config-hints-as-errors",
    "cpd": "jscpd .",
    "check-suppressions": "tsx check-suppressions.ts",
    "check-em-dash": "tsx check-em-dash.ts",
    "check-skill-frontmatter": "node scripts/check-skill-frontmatter.ts",
    "check-versions": "node scripts/check-versions.ts",
    "generate-api-contract": "node scripts/generate-api-contract.ts",
    "check-contract-drift": "node scripts/generate-api-contract.ts --check",
    "check-reproducible": "node scripts/check-reproducible.ts",
    "check-memory-md-size": "node scripts/check-memory-md-size.ts",
    "check-public-copy": "node scripts/check-public-copy.ts",
    "check-openclaw-platform-fitness": "node scripts/check-openclaw-platform-fitness.ts",
    "check-package-artifact": "node scripts/check-package-artifact.ts",
    "check-reuse": "node scripts/check-reuse.ts",
    "publish-clean": "node scripts/publish-clean.ts",
    "release": "node scripts/release.ts",
    "prepack": "npm run build && npm run check-public-copy && npm run check-skill-frontmatter && npm run check-versions && npm run check-openclaw-platform-fitness && node scripts/pack-package-json.ts prepare",
    "postpack": "node scripts/pack-package-json.ts restore-after-pack",
    "prepublishOnly": "npm run check-public-copy && npm run check-skill-frontmatter && npm run check-versions && npm run build && npm run check-openclaw-platform-fitness && npm run check-package-artifact",
    "check:all": "npm run typecheck && npm run lint && npm run cpd && npm run knip && npm run check-suppressions && npm run check-em-dash && npm run check-memory-md-size && npm run check-public-copy && npm run check-skill-frontmatter && npm run check-versions && npm run build && npm run check-openclaw-platform-fitness && npm run check-package-artifact && npm run check-reproducible && npm run test:coverage && npm run check-reuse && npm run check-contract-drift && npm audit --audit-level=low"
  },
  "peerDependencies": {
    "mppx": "0.13.4",
    "openclaw": ">=2026.7.1",
    "viem": "2.57.5"
  },
  "peerDependenciesMeta": {
    "mppx": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "mppx": "0.13.4",
    "openclaw": "2026.9.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "viem": "2.57.5",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  }
}
